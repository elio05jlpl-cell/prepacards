# En-tetes HTTP pour Cloudflare Pages et Netlify.
# Ce fichier est ignore par un hebergement Apache classique comme celui d'OVH,
# ou c'est .htaccess qui joue le meme role.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://ojnntqfafinxrousdvbn.supabase.co wss://ojnntqfafinxrousdvbn.supabase.co https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

# Les images ne changent jamais sans changer de nom : on peut les garder un an
# dans le cache du navigateur.
/img/*
  Cache-Control: public, max-age=31536000, immutable

# La feuille de style est appelee avec un parametre ?v=empreinte, recalcule a
# chaque modification : un cache long est donc sans risque, le navigateur
# rechargera automatiquement la nouvelle version.
/style.css
  Cache-Control: public, max-age=31536000, immutable

# Les polices portent leur graisse dans leur nom : elles ne changent jamais.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Bibliotheque tierce vendue localement (client Supabase), appelee avec le
# meme parametre ?v=empreinte que style.css.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Lu par l'application a chaque jour d'utilisation : jamais de cache, sinon une
# mise a jour publiee resterait invisible.
/version.json
  Cache-Control: no-cache
  Content-Type: application/json; charset=utf-8

# Les pages HTML doivent etre revalidees, sinon une correction de texte peut
# rester invisible plusieurs jours pour vos visiteurs.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
